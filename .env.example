APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production: canonical public origin (HTTPS, no trailing slash). Required for correct RTD image/logo URLs from asset().
# APP_URL=https://your-api.example.com
# APP_ENV=production
# APP_DEBUG=false

# Behind a reverse proxy / load balancer (nginx, ALB, Cloudflare). Use * or comma-separated IPs.
# TRUSTED_PROXIES=*

# RTD uploads live under public/uploads/rtd/ (no php artisan storage:link). Ensure that tree exists on deploy and is writable by the web user.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Matchmaking: set to true to use location/distance in matching; false = all India (materials/specs only)
# MATCHMAKING_USE_LOCATION=false

# V2 Matchmaking Engine (v1 = legacy, v2 = Domain\MatchEngine + lazy matching for new users)
# Use v2 so newly registered dealers/converters see existing qualifying inquiries in Sourcing Hub
MATCH_ENGINE=v1

VITE_APP_NAME="${APP_NAME}"

# Razorpay (wallet credit purchases). Never commit real secrets.
#
# Test vs live: whatever you put here is what the API uses. Test Key ID starts with rzp_test_;
# live starts with rzp_live_. Checkout test UPI (e.g. success@razorpay) only works with test keys.
#
# Get keys: https://dashboard.razorpay.com/ → sign in → turn ON “Test Mode” (top bar) →
# Settings → API Keys → generate/copy Key Id and Key Secret → paste below.
# For production, switch Test Mode OFF and use live keys on the server only.
#
# Active keys used by app right now (TEST mode)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Keep live values commented for quick switch on deployment servers only:
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_CURRENCY=INR
# Exact-credits Razorpay (e.g. pay-for-post): INR per credit, max credits per order.
# WALLET_INR_PER_CREDIT=1
# WALLET_EXACT_CREDITS_MAX=500
# Local only: allow legacy POST /wallet/purchase without gateway (never true in production).
# APP_FAKE_PAYMENTS=false

# RTD: when true, POST /rtd/orders/{id}/confirm-payment marks PAID without Razorpay (tests only; never in production).
# RTD_ALLOW_DIRECT_CONFIRM_PAYMENT=false

# Firebase Cloud Messaging (push notifications).
# Path (relative to project root) to the service-account JSON downloaded from
# Firebase Console → Project Settings → Service accounts. Keep this file OUT of git.
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
# Set false to disable sending pushes (DB notifications still created).
PUSH_NOTIFICATIONS_ENABLED=true
