								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"materials\": [\n        {\n            \"material_id\": 1,\n            \"brand_id\": null,\n            \"agent_type\": null,\n            \"finish_ids\": [1, 2],\n            \"thickness_ranges\": [\n                {\n                    \"unit\": \"GSM\",\n                    \"min\": 200,\n                    \"max\": 400\n                },\n                {\n                    \"unit\": \"MM\",\n                    \"min\": 0.5,\n                    \"max\": 2.0\n                }\n            ]\n        },\n        {\n            \"material_id\": 2,\n            \"brand_id\": 1,\n            \"agent_type\": \"AUTHORIZED_AGENT\",\n            \"finish_ids\": [3, 4],\n            \"thickness_ranges\": [\n                {\n                    \"unit\": \"GSM\",\n                    \"min\": 150,\n                    \"max\": 300\n                }\n            ]\n        }\n    ],\n    \"machines_available\": [1, 2, 3],\n    \"capacity_daily\": 1000.50,\n    \"capacity_monthly\": 30000.00,\n    \"capacity_unit\": \"kg\",\n    \"has_warehouse\": true,\n    \"bulk_orders_note\": \"We specialize in bulk orders only\",\n    \"locations\": [\n        {\n            \"type\": \"factory\",\n            \"address\": \"123 Industrial Street, Sector 18\",\n            \"latitude\": 28.6139,\n            \"longitude\": 77.2090,\n            \"city\": \"Delhi\",\n            \"state\": \"Delhi\"\n        },\n        {\n            \"type\": \"warehouse\",\n            \"address\": \"456 Warehouse Road\",\n            \"latitude\": 28.7041,\n            \"longitude\": 77.1025,\n            \"city\": \"Noida\",\n            \"state\": \"Uttar Pradesh\"\n        }\n    ]\n}",
							"options": {
