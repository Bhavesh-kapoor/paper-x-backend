								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/brands",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "brands"]
						}
					}
				}
			]
		},
		{
			"name": "3. Brand - Post Requirement (Legacy)",
			"description": "Brand posting API for packaging/printing requirements (Legacy endpoint)",
