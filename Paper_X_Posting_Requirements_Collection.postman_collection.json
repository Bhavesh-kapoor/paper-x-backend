								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/inquiries/{{draft_inquiry_id}}/post",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "inquiries", "{{draft_inquiry_id}}", "post"]
						},
						"description": "Post the inquiry (change from DRAFT to POSTED) and trigger matchmaking. This will deduct credits from wallet."
					}
				},
				{
					"name": "Get Posting Status",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/inquiries/{{posted_inquiry_id}}/posting-status",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "inquiries", "{{posted_inquiry_id}}", "posting-status"]
						},
