		{
			"name": "4. Brand/Converter - Post Inquiry (New Unified System)",
			"description": "New unified inquiry system for Brand and Converter roles. Create inquiry in DRAFT, then post it.",
			"item": [
				{
					"name": "Create Inquiry (DRAFT) - Material Buy",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201 || pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.id) {",
									"        pm.collectionVariables.set('draft_inquiry_id', jsonData.data.id);",
									"        console.log('✅ Draft inquiry created:', jsonData.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Need Duplex Board 350 GSM\",\n    \"description\": \"Looking for premium quality duplex board for packaging\",\n    \"items\": [\n        {\n            \"material_id\": 1,\n            \"material_category\": \"Duplex Board\",\n            \"finish_coating\": \"None\",\n            \"thickness_gsm\": 350,\n            \"thickness_unit\": \"gsm\",\n            \"quantity\": 2000,\n            \"quantity_unit\": \"sheets\",\n            \"additional_specs\": {\n                \"size\": \"28x40\",\n                \"grade\": \"A\"\n            }\n        }\n    ],\n    \"urgency\": \"urgent\",\n    \"location\": \"Mumbai, Maharashtra\",\n    \"latitude\": 19.0760,\n    \"longitude\": 72.8777,\n    \"timeline\": \"3-5 Days\",\n    \"deadline\": \"2024-12-31\"\n}",
