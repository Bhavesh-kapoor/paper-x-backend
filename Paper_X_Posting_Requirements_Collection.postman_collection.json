							"raw": "{\n    \"inquiry_id\": {{draft_inquiry_id}}\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/inquiries/calculate-fee",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "inquiries", "calculate-fee"]
