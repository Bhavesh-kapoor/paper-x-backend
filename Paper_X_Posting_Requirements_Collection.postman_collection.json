						"url": {
							"raw": "{{base_url}}/api/v1/inquiries/{{posted_inquiry_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "inquiries", "{{posted_inquiry_id}}"]
						}
					}
				}
			]
		},
