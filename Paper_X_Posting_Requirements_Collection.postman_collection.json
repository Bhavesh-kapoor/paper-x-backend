							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201 || pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.inquiry_id) {",
									"        pm.collectionVariables.set('last_inquiry_id', jsonData.data.inquiry_id);",
									"        console.log('✅ Inquiry created:', jsonData.data.inquiry_id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
