						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"requirement_type\": \"Packaging\",\n    \"packaging_type\": \"Rigid Boxes\",\n    \"quantity_range\": \"1000-5000\",\n    \"timeline\": \"3–5 Days\",\n    \"special_needs\": \"Need eco-friendly packaging with premium finish\",\n    \"design_attachments\": [],\n    \"title\": \"Need 1500 Custom Cake Boxes\",\n    \"description\": \"Looking for premium quality rigid boxes for cake packaging\",\n    \"urgency\": \"normal\",\n    \"location\": \"Mumbai, Maharashtra\",\n    \"city\": \"Mumbai\",\n    \"latitude\": 19.0760,\n    \"longitude\": 72.8777\n}",
