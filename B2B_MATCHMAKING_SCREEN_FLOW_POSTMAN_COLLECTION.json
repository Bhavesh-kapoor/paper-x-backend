{
	"info": {
		"_postman_id": "b2b-screen-flow-2026",
		"name": "B2B Matchmaking - Screen Flow API Collection",
		"description": "Complete Postman collection for B2B matchmaking platform APIs mapped to mobile app screens.\n\n**Base URL**: `http://127.0.0.1:8000/api/v1`\n\n**Screen Flow**:\n1. Post Requirement Screen → Save Step\n2. Payment Confirmation → Calculate Fee → Post\n3. Posting Success → Get Status\n4. Sourcing Hub → Get Active Sessions\n5. Matchmaking Responses → Get Responses → Shortlist\n6. Session Locked → Lock Session → Get Details\n7. Partner Chat → Chat Messages\n8. Session History → Get History → Republish",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "paper-x-backend"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Request OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    pm.test(\"OTP request successful\", function () {",
									"        pm.response.to.have.status(200);",
									"        var jsonData = pm.response.json();",
									"        pm.expect(jsonData.success).to.eql(true);",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mobile\": \"9876543210\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/otp/request",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "otp", "request"]
						}
					}
				},
				{
					"name": "Verify OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.token) {",
									"        pm.environment.set(\"auth_token\", jsonData.data.token);",
									"        pm.collectionVariables.set(\"auth_token\", jsonData.data.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mobile\": \"9876543210\",\n  \"otp\": \"123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/otp/verify",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "otp", "verify"]
						}
					}
				}
			]
		},
		{
			"name": "2. Post Requirement Screen (Step 2 of 9)",
			"item": [
				{
					"name": "Save Inquiry Step",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.inquiry_id) {",
									"        pm.environment.set(\"inquiry_id\", jsonData.data.inquiry_id);",
									"        pm.collectionVariables.set(\"inquiry_id\", jsonData.data.inquiry_id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"step\": 2,\n  \"inquiry_id\": null,\n  \"material_category\": \"Corrugated\",\n  \"packaging_type\": \"Boxes\",\n  \"thickness_gsm\": 150,\n  \"thickness_unit\": \"gsm\",\n  \"size\": \"10x12 inches\",\n  \"quantity\": 5000,\n  \"quantity_unit\": \"units\",\n  \"urgency\": \"normal\",\n  \"location\": \"Mumbai, Maharashtra\",\n  \"latitude\": 19.0760,\n  \"longitude\": 72.8777\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/inquiries/save-step",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "inquiries", "save-step"]
						},
						"description": "Save inquiry step data (Step 2 of 9 - Technical Specifications). Supports multi-step inquiry creation."
					}
				}
			]
		},
