						"description": "Calculate posting fee before posting. Shows:\n- Standard Post Fee: 50 Credits\n- Urgency Add-on: +20 Credits (if urgent)\n- Total Cost\n- Wallet Balance\n- Sufficient Credits Check"
					}
				},
				{
					"name": "Pay & Post Inquiry",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.inquiry && jsonData.data.inquiry.session) {",
									"        pm.environment.set(\"session_id\", jsonData.data.inquiry.session.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/inquiries/{{inquiry_id}}/post",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "inquiries", "{{inquiry_id}}", "post"]
						},
						"description": "Post inquiry and trigger matchmaking. Deducts credits and starts finding matches."
					}
				}
			]
