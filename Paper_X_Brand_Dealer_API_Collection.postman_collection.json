{
	"info": {
		"_postman_id": "paper-x-brand-dealer-api",
		"name": "Paper X - Brand & Dealer API Collection",
		"description": "Complete API collection for Brand Requirement Posting and Dealer Operations\n\n## Features:\n- Brand registration and profile completion\n- Brand requirement posting with 7-step flow\n- Brand inquiry management\n- Dealer profile completion\n- Dealer opportunity management\n- Dealer session and chat\n- Converter requirement viewing and response\n\n## Authentication:\nAll protected endpoints require: `Authorization: Bearer {token}`\n\n## Base URL:\nUpdate `base_url` variable with your server URL (e.g., http://localhost:8000)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "paper-x-brand-dealer"
	},
	"item": [
		{
			"name": "Authentication",
			"description": "Authentication endpoints for OTP-based login",
			"item": [
				{
					"name": "Request OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    console.log('OTP requested successfully');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"mobile\": \"9876543210\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/otp/request",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "otp", "request"]
						},
						"description": "Request OTP for mobile number. OTP will be sent to the provided mobile number."
					},
					"response": []
				},
				{
					"name": "Verify OTP & Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.token) {",
									"        pm.environment.set('auth_token', jsonData.data.token);",
									"        pm.collectionVariables.set('auth_token', jsonData.data.token);",
									"        console.log('Token saved:', jsonData.data.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"mobile\": \"9876543210\",\n    \"otp\": \"123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/otp/verify",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "otp", "verify"]
						},
						"description": "Verify OTP and login. Token will be automatically saved to collection variables."
					},
					"response": []
				}
			]
		},
